{
  "compilerOptions": {
    "module": "esnext",
    "target": "es6",
    "moduleResolution": "bundler",
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "strictNullChecks": true,
    "alwaysStrict": true,
    "pretty": true,
    "noImplicitAny": true,
    "noImplicitReturns": true,
    "experimentalDecorators": true,
    "lib": ["es2017"],
    "types": ["node"]
  },
  "include": ["src", "test"],
  "exclude": ["node_modules", "lib"]
}
