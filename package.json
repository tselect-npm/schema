{
  "name": "@tselect/schema",
  "description": "Typed, programmatic JSON schemas.",
  "version": "1.0.0",
  "license": "MIT",
  "author": "Sylvain Estevez",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "cov": "vitest run --coverage",
    "lint": "tslint --project ./",
    "fix": "tslint --fix --project ./",
    "typecheck": "tsc --noEmit",
    "build": "tsdown",
    "prepack": "pnpm build",
    "prepublishOnly": "pnpm lint && pnpm cov && pnpm build"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tselect-npm/schema.git"
  },
  "bugs": {
    "url": "https://github.com/tselect-npm/schema/issues"
  },
  "homepage": "https://github.com/tselect-npm/schema#readme",
  "packageManager": "pnpm@11.21.0",
  "dependencies": {
    "@bluejay/utils": "^4.0.0",
    "lodash": "^4.17.21"
  },
  "devDependencies": {
    "@types/lodash": "^4.14.200",
    "@types/node": "22.20.1",
    "@vitest/coverage-v8": "^4.1.10",
    "ajv": "^8.17.1",
    "tsdown": "^0.22.14",
    "tslint": "6.1.3",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
