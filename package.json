{
  "name": "@tselect/schema",
  "description": "Typed, programmatic JSON schemas.",
  "version": "1.0.0",
  "license": "MIT",
  "author": "Sylvain Estevez",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "mocha -r ts-node/register -r test/setup.ts --recursive test/**/*.test.ts",
    "cov": "nyc npm test",
    "lint": "tslint --project ./",
    "fix": "tslint --fix --project ./",
    "typecheck": "tsc --noEmit",
    "build": "tsdown",
    "prepack": "pnpm build",
    "prepublishOnly": "pnpm lint && pnpm cov && pnpm build"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tselect-npm/schema.git"
  },
  "bugs": {
    "url": "https://github.com/tselect-npm/schema/issues"
  },
  "homepage": "https://github.com/tselect-npm/schema#readme",
  "packageManager": "pnpm@11.21.0",
  "dependencies": {
    "@bluejay/utils": "^4.0.0",
    "lodash": "^4.17.21"
  },
  "devDependencies": {
    "@types/chai": "^4.3.9",
    "ajv": "^6.12.6",
    "@types/lodash": "^4.14.200",
    "@types/mocha": "5.2.3",
    "@types/node": "22.20.1",
    "chai": "^4.3.10",
    "mocha": "^10.2.0",
    "nyc": "15.1.0",
    "ts-node": "^9.1.1",
    "tsdown": "^0.22.14",
    "tslint": "6.1.3",
    "typescript": "^7.0.2"
  }
}
