{
  "name": "@tselect/schema",
  "version": "1.0.0",
  "description": "Typed, programmatic JSON schemas.",
  "keywords": [
    "json-schema",
    "jsonschema",
    "schema",
    "validation",
    "ajv",
    "typescript",
    "typed",
    "factory",
    "builder",
    "draft-07",
    "esm"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "cov": "vitest run --coverage",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "build": "tsdown",
    "prepack": "pnpm build",
    "prepublishOnly": "pnpm lint && pnpm cov && pnpm build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tselect-npm/schema.git"
  },
  "author": "Sylvain Estevez",
  "license": "MIT",
  "packageManager": "pnpm@11.21.0",
  "bugs": {
    "url": "https://github.com/tselect-npm/schema/issues"
  },
  "homepage": "https://github.com/tselect-npm/schema#readme",
  "dependencies": {
    "@bluejay/utils": "^4.0.0",
    "lodash": "^4.17.21"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@types/lodash": "^4.14.200",
    "@types/node": "22.20.1",
    "@vitest/coverage-v8": "^4.1.10",
    "ajv": "^8.17.1",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
